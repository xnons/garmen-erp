# ============================================================
# Master Garment ERP - Backend Environment
# Salin file ini menjadi `.env` lalu isi nilainya.
# JANGAN commit `.env` yang sudah terisi ke git.
# ============================================================

# --- Database (WAJIB) ---
# Postgres (Supabase / Render) atau sqlite:///./local.db untuk dev lokal
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Mode ---
# true  = pengembangan lokal (mengizinkan fallback SECRET_KEY dev)
# false = produksi (SECRET_KEY WAJIB diisi, server gagal start jika kosong)
DEV_MODE=false

# --- Keamanan JWT (WAJIB di produksi) ---
# String acak panjang (>= 32 char). Contoh generate:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Diterima juga sebagai JWT_SECRET_KEY (alias).
SECRET_KEY=
ALGORITHM=HS256
# Masa berlaku token akses dalam menit (default 480 = 8 jam)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- CORS ---
# Daftar origin frontend yang diizinkan, dipisah koma. Tanpa trailing slash.
ALLOWED_ORIGINS=http://localhost:3000,https://garmen-erp-1.onrender.com

# --- PIN Master Sistem ---
# Hanya dipakai saat seeding awal SystemSecurity; setelah itu disimpan ter-hash.
MASTER_PIN=123456

# --- AI Co-Pilot (OpenRouter) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_NAME=Master Garment ERP

# --- Email / SMTP (opsional, untuk laporan eksekutif & alert) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EXECUTIVE_REPORT_EMAIL_TO=
EMAIL_FROM=Master Garment ERP <noreply@example.com>
