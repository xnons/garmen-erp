    # 🟢 Filter Tanggal Ketat untuk Memisahkan Hari Ini dan Riwayat Arsip
    if tanggal:
        query = query.filter(models.LogOutputBorongan.tanggal == tanggal)
        
    if karyawan_id:
        query = query.filter(models.LogOutputBorongan.karyawan_id == karyawan_id)
