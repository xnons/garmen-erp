        }

        if (totalTargetQty <= 0) {
            setErrorMsg('Target Qty wajib lebih dari 0 Pcs. Silakan isi rincian Size Matrix!');
            return;
        }

        if (!hargaJualVal || hargaJualVal <= 0) {
            setErrorMsg('Harga Jual ke Client wajib diisi untuk menghitung estimasi omset & margin!');
            return;
        }

        setSubmitting(true);

        try {
