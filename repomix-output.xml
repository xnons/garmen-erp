                tanggal_mulai: tanggalMulai,
                deadline,
                status: 'ON_PROGRESS' as const,

                // Sub-Proses Tariffs
                tarif_initial: tarifList,
            };

            await produksiService.createSPK(payload);
            onSuccess();
            onClose();
        } catch (err: any) {
